<lcui-app>
  <ui>
    <dialog>
      <dialog-trigger>
        <button variant="outline">Open Dialog</button>
      </dialog-trigger>
      <portal>
        <dialog-overlay>
          <dialog-content>
            <dialog-header>
              <dialog-title>Edit profile</dialog-title>
              <dialog-description>
                Make changes to your profile here. Click save when you're done.
              </dialog-description>
            </dialog-header>
            <field>
              <label>Name</label>
              <textinput tabindex="0">Pedro Duarte</textinput>
            </field>
            <field>
              <label>Username</label>
              <textinput tabindex="0">@peduarte</textinput>
            </field>
            <dialog-footer>
              <button variant="outline" data-dialog-close="true">Cancel</button>
              <button variant="primary">Save changes</button>
            </dialog-footer>
            <button class="dialog-close" variant="ghost" size="icon" data-dialog-close="true"><icon name="dismiss" /></button>
          </dialog-content>
        </dialog-overlay>
      </portal>
    </dialog>
  </ui>
</lcui-app>
